{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transferkit.local/schema/checkpoint-state.schema.json",
  "title": "TransferKit Recovery Checkpoint State",
  "description": "Authoritative target checkpoint snapshot for one immutable transfer manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "transfer_id",
    "manifest_sha256",
    "source_fingerprint",
    "target_fingerprint",
    "protocol_version",
    "source_app_version",
    "target_app_version",
    "updated_at",
    "categories"
  ],
  "properties": {
    "version": { "const": "1.0" },
    "transfer_id": { "type": "string", "format": "uuid" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "source_fingerprint": { "$ref": "#/$defs/sha256" },
    "target_fingerprint": { "$ref": "#/$defs/sha256" },
    "protocol_version": { "type": "string", "pattern": "^[1-9][0-9]{0,4}$" },
    "source_app_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "target_app_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "updated_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "categories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/category_id" },
      "additionalProperties": { "$ref": "#/$defs/category" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "category_id": {
      "enum": ["photos", "videos", "audio", "documents", "downloads", "contacts", "calendar", "sms", "call_log", "apks", "settings", "app_data", "wifi_passwords", "launcher_layout", "accounts", "drm", "banking_apps", "two_factor_tokens"]
    },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items_total", "items_verified", "items_failed", "items_pending", "items_partial"],
      "properties": {
        "items_total": { "$ref": "#/$defs/count" },
        "items_verified": { "$ref": "#/$defs/count" },
        "items_failed": { "$ref": "#/$defs/count" },
        "items_pending": { "$ref": "#/$defs/count" },
        "items_partial": { "type": "array", "items": { "$ref": "#/$defs/partial_item" } }
      }
    },
    "partial_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "next_expected_chunk", "total_chunks", "next_byte_offset"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "next_expected_chunk": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "total_chunks": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "next_byte_offset": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    }
  }
}
