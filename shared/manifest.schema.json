{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transferkit.local/schema/manifest.schema.json",
  "title": "TransferKit Transfer Manifest",
  "description": "Source inventory and integrity digests for a single transfer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "transfer_id", "created_at", "source_device", "categories"],
  "properties": {
    "version": { "const": "1.0" },
    "transfer_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{6})?Z$"
    },
    "source_device": { "$ref": "#/$defs/device" },
    "categories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": ["photos", "videos", "audio", "documents", "downloads", "contacts", "calendar", "sms", "call_log", "apks", "settings", "app_data", "wifi_passwords", "launcher_layout", "accounts", "drm", "banking_apps", "two_factor_tokens"]
      },
      "additionalProperties": { "$ref": "#/$defs/category" }
    }
  },
  "$defs": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturer", "model", "sdk", "fingerprint"],
      "properties": {
        "manufacturer": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
        "model": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
        "sdk": { "type": "integer", "minimum": 26, "maximum": 2147483647 },
        "fingerprint": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S" }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "method", "items"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
        "method": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
        "items": {
          "type": "array",
          "maxItems": 100000,
          "description": "May be empty when a selected category contains no accessible items; semantic validators cap the total across categories at 100000.",
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "size", "sha256", "metadata"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S" },
        "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "metadata": { "type": "object" }
      }
    }
  }
}
