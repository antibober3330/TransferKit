{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transferkit.local/schema/manifest.schema.json",
  "title": "TransferKit Transfer Manifest",
  "description": "Source inventory and integrity digests for a single transfer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "transfer_id", "created_at", "source_device", "categories"],
  "properties": {
    "version": { "const": "1.0" },
    "transfer_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "source_device": { "$ref": "#/$defs/device" },
    "categories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": ["photos", "videos", "audio", "documents", "downloads", "contacts", "calendar", "sms", "call_log", "apks", "settings", "app_data", "wifi_passwords", "launcher_layout", "accounts", "drm", "banking_apps", "two_factor_tokens"]
      },
      "additionalProperties": { "$ref": "#/$defs/category" }
    }
  },
  "$defs": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturer", "model", "sdk", "fingerprint"],
      "properties": {
        "manufacturer": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sdk": { "type": "integer", "minimum": 26 },
        "fingerprint": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "method", "items"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "method": { "type": "string", "minLength": 1, "maxLength": 128 },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "size", "sha256", "metadata"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "metadata": { "type": "object" }
      }
    }
  }
}
