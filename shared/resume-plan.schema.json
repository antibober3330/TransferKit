{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transferkit.local/schema/resume-plan.schema.json",
  "title": "TransferKit Recovery Resume Plan",
  "description": "Source proposal to resume only unfinished items from the target-authoritative checkpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "transfer_id", "manifest_sha256", "items", "requires_user_confirmation"],
  "properties": {
    "version": { "const": "1.0" },
    "transfer_id": { "type": "string", "format": "uuid" },
    "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } },
    "requires_user_confirmation": { "const": true }
  },
  "$defs": {
    "category_id": {
      "enum": ["photos", "videos", "audio", "documents", "downloads", "contacts", "calendar", "sms", "call_log", "apks", "settings", "app_data", "wifi_passwords", "launcher_layout", "accounts", "drm", "banking_apps", "two_factor_tokens"]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "item_id", "start_chunk", "byte_offset", "total_chunks"],
      "properties": {
        "category_id": { "$ref": "#/$defs/category_id" },
        "item_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "start_chunk": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "byte_offset": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "total_chunks": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    }
  }
}
